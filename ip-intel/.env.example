# Optional enrichment. ip-intel runs fully without any of these — each turns on
# automatically only when its key or database is configured. Copy to .env
# (gitignored) and load it (e.g. `export $(grep -v '^#' .env | xargs)`).

# --- Reputation ---
# AbuseIPDB free tier — https://www.abuseipdb.com/register  (1000 checks/day)
# Adds a confidence score + report count to the Abuse section.
ABUSEIPDB_KEY=

# Scamalytics — https://scamalytics.com/ (free API on request). BASE includes
# your account path; KEY is your API key. Adds a fraud score + risk band.
SCAMALYTICS_BASE=            # e.g. https://api11.scamalytics.com/<your-username>
SCAMALYTICS_KEY=

# --- Geolocation databases (local files) ---
# MaxMind GeoLite2-City — free with a MaxMind account/license key.
# Download GeoLite2-City.mmdb and point at it. Needs: pip install .[maxmind]
MAXMIND_DB=                  # e.g. /path/to/GeoLite2-City.mmdb

# IP2Location LITE — free BIN download from https://lite.ip2location.com/
# Needs: pip install .[ip2location]
IP2LOCATION_DB=              # e.g. /path/to/IP2LOCATION-LITE-DB11.BIN
